# Copy to .env (gitignored) and fill in. Never paste these into a chat, a
# terminal command, or a commit — .env keeps them out of shell history too.

# Use a key from an ORDINARY workspace and leave ANTHROPIC_WORKSPACE_ID unset.
#
# Do not use a key from the "Claude Code" workspace. Those are minted by Claude
# Code's OAuth login rather than created by hand, they are identity-linked, and
# they require an anthropic-workspace-id header on every request. If you see
#   "anthropic-workspace-id is required when authenticating with an
#    identity-linked API key"
# that is the key you have. Create a normal workspace in the Console, create a
# key inside it, and delete the ANTHROPIC_WORKSPACE_ID line below.
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_WORKSPACE_ID=wrkspc_...   # only for identity-linked keys

# Razorpay TEST MODE only. A key not starting with rzp_test_ is refused before
# any request leaves the process. Dashboard -> Account & Settings -> API Keys,
# with the Test Mode toggle on.
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=
